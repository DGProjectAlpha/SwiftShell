# Maintainer: SwiftShell contributors
# Draft only. Do not publish until a license is chosen and this package
# has been built on an Arch system. sha256sums uses SKIP on purpose.

pkgname=swiftshell
pkgver=0.1.0
pkgrel=1
pkgdesc='Transparent Quickshell bar for Hyprland'
arch=('any')
url='https://github.com/DGProjectAlpha/SwiftShell'
license=('LicenseRef-None')
depends=('quickshell' 'hyprland' 'qt6-base' 'qt6-declarative')
source=("$pkgname-$pkgver.tar.gz::https://github.com/DGProjectAlpha/SwiftShell/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/SwiftShell-$pkgver"
    install -d "$pkgdir/usr/share/swiftshell/lib"
    cp -a shell "$pkgdir/usr/share/swiftshell/app"
    rm -f "$pkgdir/usr/share/swiftshell/app/assets/wallpapers/swiftshell-default-crimson.png"
    install -d "$pkgdir/usr/share/swiftshell/app/assets/wallpapers"
    install -m 0644 assets/wallpapers/swiftshell-default-crimson.png "$pkgdir/usr/share/swiftshell/app/assets/wallpapers/swiftshell-default-crimson.png"
    install -m 0644 scripts/lib/common.sh "$pkgdir/usr/share/swiftshell/lib/common.sh"
    install -m 0644 scripts/lib/deps.sh "$pkgdir/usr/share/swiftshell/lib/deps.sh"
    install -m 0644 scripts/lib/doctor.sh "$pkgdir/usr/share/swiftshell/lib/doctor.sh"
    install -m 0755 scripts/lib/activate.sh "$pkgdir/usr/share/swiftshell/lib/activate.sh"
    install -m 0755 scripts/lib/deactivate.sh "$pkgdir/usr/share/swiftshell/lib/deactivate.sh"
    install -m 0755 scripts/lib/uninstall.sh "$pkgdir/usr/share/swiftshell/lib/uninstall.sh"
    install -m 0755 scripts/swiftshell "$pkgdir/usr/share/swiftshell/lib/swiftshell"
    cat >"$pkgdir/usr/share/swiftshell/manifest" <<EOF
product=swiftshell
format=1
git_commit=tag-v$pkgver
install_type=package
EOF
    install -d "$pkgdir/usr/bin"
    install -m 0755 packaging/swiftshell-system "$pkgdir/usr/bin/swiftshell"
}
